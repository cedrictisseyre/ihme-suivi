# Copier dans .env.server SUR LE SERVEUR uniquement, hors dépôt Git.
APP_IMAGE=ghcr.io/votre-compte/ihme-suivi:REMPLACER_PAR_SHA
DATABASE_URL=postgresql://ihme_suivi:REMPLACER@postgres:5432/ihme_suivi
ADMIN_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_UNIQUE
PUBLIC_ORIGIN=https://suivi.votre-domaine.fr
# Origine de la galerie étudiante pour les liens vers les sites provisionnés.
STUDENT_ORIGIN=https://projets.votre-domaine.fr
COOKIE_SECURE=true
APP_VERSION=REMPLACER_PAR_SHA
DB_NETWORK=ihme-database
PROXY_NETWORK=ihme-web
# Optionnel : jetons en lecture seule, uniquement côté serveur.
GITHUB_TOKEN=
GITLAB_TOKEN=
