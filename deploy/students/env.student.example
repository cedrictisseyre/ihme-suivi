# Exemple fictif. Installer sous /etc/ihme-students/p01/.env.student (root:root, 0600).
# Les noms de réseaux et identifiants sont attribués par l'enseignant.
STUDENT_ID=p01
STUDENT_IMAGE_REPOSITORY=ghcr.io/compte-exemple/projet-exemple
DATABASE_URL=postgresql://ihme_p01:REMPLACER@postgres-p01:5432/ihme_p01
# Générer un secret aléatoire propre au projet (au moins 32 caractères), jamais dans Git.
JWT_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_PRIVE
PUBLIC_ORIGIN=https://p01.votre-domaine.fr
DB_NETWORK=ihme-p01-db
PROXY_NETWORK=ihme-p01-web
